      "BRT": { "commandTemplate": "laminar/A333/buttons/fms{cdu}_brightness_up", "verified": true },
      "DIM": { "commandTemplate": "laminar/A333/buttons/fms{cdu}_brightness_dn", "verified": true }
    }
