{
  "id": "xplane12-default-fms",
  "label": "X-Plane 12 default FMS/MCDU",
  "description": "Screen and keypad mapping for X-Plane 12's built-in default FMS, confirmed live against a running X-Plane 12.4.3 with the stock Airbus A330 loaded (2026-08-04, via tools/smoke-test.mjs). Command names live under sim/FMS (CDU1), sim/FMS2 (CDU2), sim/CDU3 (CDU3) — same key set, three different prefixes, hence commandPrefixByCdu below. Re-run the smoke test on other default aircraft before trusting this unchanged; add-on airliners (Zibo 737, FlightFactor, ToLiss, ...) use entirely different, aircraft-specific namespaces.",

  "screen": {
    "_note": "X-Plane exposes 16 text/style dataref slots (line0..line15), but the real CDU only ever renders 14 (title + 6 label/data pairs + scratchpad) — lines 14/15 were consistently blank in live captures. Rendering all 16 anyway just adds two rows of dead black space at the bottom.",
    "lines": 14,
    "cols": 24,
    "textDatarefTemplate": "sim/cockpit2/radios/indicators/fms_cdu{cdu}_text_line{line}",
    "styleDatarefTemplate": "sim/cockpit2/radios/indicators/fms_cdu{cdu}_style_line{line}"
  },

  "commandPrefixByCdu": {
    "1": "sim/FMS",
    "2": "sim/FMS2",
    "3": "sim/CDU3"
  },

  "_note_on_verified_flag": "verified:true means this exact suffix (under the CDU's prefix above) was seen in a live X-Plane 12.4.3 command list on 2026-08-04. Buttons whose composed command still fails to resolve at connect time (e.g. a future X-Plane version renames something) are disabled in the UI rather than silently doing nothing.",
  "_note_on_brightness_group": "keys.brightness (BRT/DIM) is the one exception to commandPrefixByCdu: unlike everything else in this file, laminar/A333/buttons/fmsN_brightness_up/dn is Airbus-specific (not a generic sim/FMS* name), found alongside the keypad commands during the same live scan. Its entries use commandTemplate ({cdu} substituted directly) instead of the prefix+command composition.",

  "keys": {
    "numeric": {
      "0": { "command": "key_0", "verified": true },
      "1": { "command": "key_1", "verified": true },
      "2": { "command": "key_2", "verified": true },
      "3": { "command": "key_3", "verified": true },
      "4": { "command": "key_4", "verified": true },
      "5": { "command": "key_5", "verified": true },
      "6": { "command": "key_6", "verified": true },
      "7": { "command": "key_7", "verified": true },
      "8": { "command": "key_8", "verified": true },
      "9": { "command": "key_9", "verified": true }
    },
    "alpha": {
      "A": { "command": "key_A", "verified": true },
