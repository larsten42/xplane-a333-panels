  "keypadLayout": {
    "_note": "Physical bezel layout as described live against a running B738 (2026-08-10) — 6 columns on the two function rows (Airbus has 7: no dedicated brightness buttons here, just a knob — see _note_on_brightness — rendered as an inert decorative keycap for now), and no UP/DOWN or AIRPORT keys in the utility block (2x2, not Airbus's 2x3). Alpha/numeric blocks are the same as the Airbus bezel except the alpha block's bottom row.",
    "functionBlock": {
      "cols": 6,
      "rows": [
        ["INDEX", "FPLN", "CLB", "CRZ", "DES", ""],
        ["DIR_INTC", "LEGS", "DEP_ARR", "HOLD", "PROG", "EXEC"]
      ]
    },
    "utilityBlock": {
      "cols": 2,
      "rows": [
        ["FIX", "NAVRAD"],
        ["PREV", "NEXT"]
      ]
    },
    "numericBlock": {
      "cols": 3,
      "rows": [
        ["1", "2", "3"],
        ["4", "5", "6"],
        ["7", "8", "9"],
        ["PERIOD", "0", "MINUS"]
      ]
    },
    "alphaBlock": {
